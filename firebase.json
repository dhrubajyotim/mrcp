{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc.example",
      "**/.*",
      "**/node_modules/**",
      "**/__pycache__/**",
      "**/*.py",
      "**/*.pyc",
      "**/*.pyo",
      "**/*.db",
      "**/*.pdf",
      "requirements.txt",
      "README.md"
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.@(html|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|webp|gif|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/static/index.html"
      }
    ]
  }
}
